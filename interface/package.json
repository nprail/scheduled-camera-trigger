    "@ionic/react": "^8.0.0",
    "ionicons": "^7.0.0",
    "lodash": "^4.17.21",
    "luxon": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@types/lodash": "^4.14.195",
    "@types/luxon": "^3.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
